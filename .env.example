# --- Required ---
ADMIN_PASSWORD=choose-a-long-password        # protects the dashboard (username can be anything)
TIMEZONE=America/Los_Angeles                 # IANA name, e.g. America/New_York

# --- Google Health API (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Alexa, via Voice Monkey (voicemonkey.io > Settings / Devices) ---
VOICEMONKEY_TOKEN=
VOICEMONKEY_DEVICE=                          # ID of your "Routine Trigger" device

# --- Optional ---
DB_PATH=data/sleepalarm.db
